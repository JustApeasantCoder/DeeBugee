    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>DebugLoggingToolkit.Extensions.Logging</PackageId>
    <Version>0.1.0</Version>
    <Authors>Debug Logging Toolkit Contributors</Authors>
    <Description>Microsoft.Extensions.Logging JSONL provider for Debug Logging Toolkit.</Description>
